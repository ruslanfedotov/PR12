<Page x:Class="PR12.Pages.Credit"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Credit">

    <StackPanel Margin="10">
        <TextBlock Text="Расчет кредита" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

        <TextBlock Text="Стоимость автомобиля:"/>
        <TextBlock x:Name="CarPriceText" FontWeight="Bold" Margin="0,0,0,10"/>

        <TextBlock Text="Первоначальный взнос (% от 10 до 90):"/>
        <TextBox x:Name="DownPaymentTextBox" Width="100" Margin="0,5"/>
        <TextBlock x:Name="DownPaymentError" Foreground="Red"/>

        <TextBlock Text="Срок кредита (от 12 до 96 месяцев):" Margin="0,10,0,0"/>
        <TextBox x:Name="LoanTermTextBox" Width="100" Margin="0,5"/>
        <TextBlock x:Name="LoanTermError" Foreground="Red"/>

        <TextBlock Text="Расчет:" FontWeight="Bold" Margin="0,20,0,5"/>
        <TextBlock x:Name="DownPaymentAmountText"/>
        <TextBlock x:Name="LoanAmountText"/>
        <TextBlock x:Name="MonthlyPaymentText" FontWeight="Bold" Foreground="Green" Margin="0,10"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Назад" Click="BackButton_Click" Width="80" Margin="0,0,10,0"/>
            <Button x:Name="FinishButton" Content="Завершить" Click="FinishButton_Click" Width="80"/>
        </StackPanel>
    </StackPanel>
</Page>