<Page x:Class="PR12.Pages.Credit"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Расчёт кредита">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" Text="Шаг 4: Расчёт кредита" 
                   Style="{StaticResource PageTitle}"/>

        <!-- Содержимое -->
        <StackPanel Grid.Row="1">
            <Border BorderBrush="#BDC3C7" BorderThickness="1" 
                    CornerRadius="5" Padding="20" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Параметры кредита:" FontWeight="Bold" Margin="0,0,0,10"/>

                    <TextBlock Text="Стоимость автомобиля:" Margin="0,0,0,5"/>
                    <TextBlock Text="1 470 000 ₽" FontWeight="Bold" FontSize="16" Margin="0,0,0,20"/>

                    <TextBlock Text="Первоначальный взнос:" Margin="0,0,0,5"/>
                    <Slider x:Name="DownPaymentSlider" Minimum="10" Maximum="90" Value="20" 
                            Margin="0,0,0,5"/>
                    <TextBlock Text="{Binding ElementName=DownPaymentSlider, Path=Value, StringFormat='{}{0}%'}" 
                               FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                    <TextBlock Text="Срок кредита (месяцев):" Margin="0,0,0,5"/>
                    <Slider x:Name="LoanTermSlider" Minimum="12" Maximum="96" Value="36" 
                            Margin="0,0,0,5"/>
                    <TextBlock Text="{Binding ElementName=LoanTermSlider, Path=Value, StringFormat='{}{0} месяцев'}" 
                               FontWeight="Bold" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border BorderBrush="#BDC3C7" BorderThickness="1" 
                    CornerRadius="5" Padding="20">
                <StackPanel>
                    <TextBlock Text="Расчёт платежей:" FontWeight="Bold" Margin="0,0,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Первоначальный взнос:" Margin="0,3"/>
                            <TextBlock Text="Сумма кредита:" Margin="0,3"/>
                            <TextBlock Text="Ежемесячный платёж:" Margin="0,3"/>
                            <Separator Margin="0,10"/>
                            <TextBlock Text="Общая сумма:" FontWeight="Bold" Margin="0,3"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                            <TextBlock Text="294 000 ₽" Margin="0,3"/>
                            <TextBlock Text="1 176 000 ₽" Margin="0,3"/>
                            <TextBlock Text="39 045 ₽" FontSize="16" FontWeight="Bold" Foreground="#27AE60" Margin="0,3"/>
                            <Separator Margin="0,10"/>
                            <TextBlock Text="1 699 620 ₽" 
                                       FontSize="18" 
                                       FontWeight="Bold" 
                                       Foreground="#E74C3C" 
                                       Margin="0,3"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Кнопки навигации -->
        <StackPanel Grid.Row="2" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button Content="← Назад" Click="BackButton_Click" 
                    Width="100" Margin="0,0,10,0"/>
            <Button Content="Завершить" Click="FinishButton_Click" 
                    Width="100" Background="#27AE60"/>
        </StackPanel>
    </Grid>
</Page>