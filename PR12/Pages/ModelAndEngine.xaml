<Page x:Class="PR12.Pages.ModelAndEngine"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Step1">

    <StackPanel Margin="20">
        <TextBlock Text="1. Выберите модель и двигатель" 
                   FontSize="16" FontWeight="Bold" Margin="0 0 0 10"/>

        <TextBlock Text="Модель:" Margin="0 10 0 5"/>
        <ComboBox x:Name="ModelComboBox" SelectedIndex="0" Height="25">
            <ComboBoxItem Content="Седан Comfort (1 200 000 ₽)"/>
            <ComboBoxItem Content="Кроссовер Sport (1 800 000 ₽)"/>
            <ComboBoxItem Content="Внедорожник Premium (2 500 000 ₽)"/>
            <ComboBoxItem Content="Хэтчбек Urban (950 000 ₽)"/>
        </ComboBox>

        <TextBlock Text="Двигатель:" Margin="0 10 0 5"/>
        <ComboBox x:Name="EngineComboBox" SelectedIndex="0" Height="25">
            <ComboBoxItem Content="1.6L Бензин (0 ₽)"/>
            <ComboBoxItem Content="2.0L Бензин (+150 000 ₽)"/>
            <ComboBoxItem Content="2.0L Дизель (+200 000 ₽)"/>
            <ComboBoxItem Content="Гибрид 1.8L (+300 000 ₽)"/>
            <ComboBoxItem Content="Электрический (+500 000 ₽)"/>
        </ComboBox>
    </StackPanel>
</Page>