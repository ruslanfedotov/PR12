<Page x:Class="PR12.Pages.Price"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Margin="20">
            <TextBlock Text="Итоговая стоимость" FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>

            <TextBlock Text="Выбранная конфигурация:" FontWeight="Bold" Margin="0,0,0,10"/>
            <TextBlock x:Name="ModelText" Margin="0,2"/>
            <TextBlock x:Name="EngineText" Margin="0,2"/>
            <TextBlock x:Name="ColorText" Margin="0,2"/>
            <TextBlock x:Name="OptionsText" Margin="0,10,0,2"/>

            <Border BorderBrush="Gray" BorderThickness="1" Padding="10" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Расчет стоимости:" FontWeight="Bold" Margin="0,0,0,10"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Базовая цена модели:" Margin="0,2"/>
                            <TextBlock Text="Доплата за двигатель:" Margin="0,2"/>
                            <TextBlock Text="Доплата за цвет:" Margin="0,2"/>
                            <TextBlock Text="Стоимость опций:" Margin="0,2"/>
                            <TextBlock Text="Итоговая стоимость:" FontWeight="Bold" Margin="0,10,0,2"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="BasePriceText" Margin="0,2"/>
                            <TextBlock x:Name="EnginePriceText" Margin="0,2"/>
                            <TextBlock x:Name="ColorPriceText" Margin="0,2"/>
                            <TextBlock x:Name="OptionsPriceText" Margin="0,2"/>
                            <TextBlock x:Name="TotalPriceText" FontWeight="Bold" Foreground="Red" Margin="0,10,0,2"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Назад" Click="BackButton_Click" Width="100" Margin="0,0,10,0"/>
                <Button Content="Кредит" Click="NextButton_Click" Width="100"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>