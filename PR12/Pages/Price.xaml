<Page x:Class="PR12.Pages.Price"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Step3">

    <StackPanel Margin="20">
        <TextBlock Text="3. Итоговая стоимость" 
                   FontSize="16" FontWeight="Bold" Margin="0 0 0 10"/>

        <TextBlock x:Name="ModelText" Margin="0 5"/>
        <TextBlock x:Name="EngineText" Margin="0 5"/>
        <TextBlock x:Name="ColorText" Margin="0 5"/>
        <TextBlock x:Name="OptionsText" Margin="0 5"/>

        <Border Height="1" Background="LightGray" Margin="0 10"/>

        <StackPanel Orientation="Horizontal">
            <TextBlock Text="Итого:" FontWeight="Bold" Margin="0 10 5 0"/>
            <TextBlock x:Name="TotalPriceText" FontSize="20" FontWeight="Bold" 
                       Foreground="Green" Margin="0 10 0 0"/>
        </StackPanel>
    </StackPanel>
</Page>