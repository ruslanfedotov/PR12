<Page x:Class="PR12.Pages.Price"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Итоговая стоимость">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" Text="Шаг 3: Итоговая стоимость"/>

        <!-- Содержимое -->
        <StackPanel Grid.Row="1">
            <Border BorderBrush="#BDC3C7" BorderThickness="1" 
                    CornerRadius="5" Padding="20" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Выбранная конфигурация:" FontWeight="Bold" Margin="0,0,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Модель:" Margin="0,5"/>
                            <TextBlock Text="Двигатель:" Margin="0,5"/>
                            <TextBlock Text="Цвет:" Margin="0,5"/>
                            <TextBlock Text="Опции:" Margin="0,15,0,5"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Седан Comfort" FontWeight="Bold" Margin="0,5"/>
                            <TextBlock Text="1.6L Бензин" FontWeight="Bold" Margin="0,5"/>
                            <TextBlock Text="Белый" FontWeight="Bold" Margin="0,5"/>
                            <TextBlock Text="Кожаный салон" Margin="0,2"/>
                            <TextBlock Text="Панорамная крыша" Margin="0,2"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border BorderBrush="#BDC3C7" BorderThickness="1" 
                    CornerRadius="5" Padding="20">
                <StackPanel>
                    <TextBlock Text="Расчёт стоимости:" FontWeight="Bold" Margin="0,0,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Базовая цена:" Margin="0,3"/>
                            <TextBlock Text="Двигатель:" Margin="0,3"/>
                            <TextBlock Text="Цвет:" Margin="0,3"/>
                            <TextBlock Text="Опции:" Margin="0,3"/>
                            <Separator Margin="0,10"/>
                            <TextBlock Text="Итого:" FontWeight="Bold" Margin="0,3"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                            <TextBlock Text="1 200 000 ₽" Margin="0,3"/>
                            <TextBlock Text="+ 0 ₽" Margin="0,3"/>
                            <TextBlock Text="+ 0 ₽" Margin="0,3"/>
                            <TextBlock Text="+ 270 000 ₽" Margin="0,3"/>
                            <Separator Margin="0,10"/>
                            <TextBlock Text="1 470 000 ₽" 
                                       FontSize="18" 
                                       FontWeight="Bold" 
                                       Foreground="#E74C3C" 
                                       Margin="0,3"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Кнопки навигации -->
        <StackPanel Grid.Row="2" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button Content="← Назад" Click="BackButton_Click" 
                    Width="100" Margin="0,0,10,0"/>
            <Button Content="Кредит →" Click="NextButton_Click" 
                    Width="100" Background="#3498DB"/>
        </StackPanel>
    </Grid>
</Page>