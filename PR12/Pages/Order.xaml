<Page x:Class="PR12.Pages.Order"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Step5">

    <StackPanel Margin="20">
        <TextBlock Text="Оформление заявки" 
                   FontSize="16" FontWeight="Bold" Margin="0 0 0 10"/>

        <TextBlock Text="Имя:" Margin="0 10 0 5"/>
        <TextBox x:Name="NameTextBox" Height="25"/>

        <TextBlock Text="Телефон:" Margin="0 10 0 5"/>
        <TextBox x:Name="PhoneTextBox" Height="25"/>

        <TextBlock Text="Email:" Margin="0 10 0 5"/>
        <TextBox x:Name="EmailTextBox" Height="25"/>
    </StackPanel>
</Page>