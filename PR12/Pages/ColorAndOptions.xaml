<Page x:Class="PR12.Pages.ColorAndOptions"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Выбор цвета и опций">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" Text="Шаг 2: Выбор цвета и опций"/>

        <!-- Содержимое -->
        <StackPanel Grid.Row="1">
            <Border BorderBrush="#BDC3C7" BorderThickness="1" 
                    CornerRadius="5" Padding="20" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Выберите цвет:" FontWeight="Bold" Margin="0,0,0,10"/>
                    <StackPanel>
                        <RadioButton Content="Белый (+0 ₽)" GroupName="Color" Margin="0,5"/>
                        <RadioButton Content="Черный (+15 000 ₽)" GroupName="Color" Margin="0,5"/>
                        <RadioButton Content="Серебристый (+20 000 ₽)" GroupName="Color" Margin="0,5"/>
                        <RadioButton Content="Синий металлик (+25 000 ₽)" GroupName="Color" Margin="0,5"/>
                        <RadioButton Content="Красный перламутр (+40 000 ₽)" GroupName="Color" Margin="0,5"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border BorderBrush="#BDC3C7" BorderThickness="1" 
                    CornerRadius="5" Padding="20">
                <StackPanel>
                    <TextBlock Text="Выберите опции:" FontWeight="Bold" Margin="0,0,0,10"/>
                    <StackPanel>
                        <CheckBox Content="Кожаный салон (+150 000 ₽)" Margin="0,5"/>
                        <CheckBox Content="Панорамная крыша (+120 000 ₽)" Margin="0,5"/>
                        <CheckBox Content="Премиум-аудиосистема (+80 000 ₽)" Margin="0,5"/>
                        <CheckBox Content="Система помощи при парковке (+60 000 ₽)" Margin="0,5"/>
                        <CheckBox Content="Адаптивный круиз-контроль (+90 000 ₽)" Margin="0,5"/>
                        <CheckBox Content="Вентиляция сидений (+70 000 ₽)" Margin="0,5"/>
                        <CheckBox Content="Подогрев руля (+25 000 ₽)" Margin="0,5"/>
                        <CheckBox Content="Беспроводная зарядка (+15 000 ₽)" Margin="0,5"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Кнопки навигации -->
        <StackPanel Grid.Row="2" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button Content="← Назад" Click="BackButton_Click" 
                    Width="100" Margin="0,0,10,0"/>
            <Button Content="Далее →" Click="NextButton_Click" 
                    Width="100" Background="#27AE60"/>
        </StackPanel>
    </Grid>
</Page>