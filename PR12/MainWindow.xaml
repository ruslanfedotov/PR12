<Window x:Class="PR12.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Конфигуратор авто" 
        Height="550" Width="650"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" Text="Конфигуратор автомобиля" 
                   FontSize="18" FontWeight="Bold" 
                   HorizontalAlignment="Center" Margin="10"/>

        <!-- Прогресс-бар -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" 
                    HorizontalAlignment="Center" Margin="10">
            <TextBlock x:Name="Step1Text" Text="1" Background="LightBlue" Width="25" 
                       Height="25" TextAlignment="Center" 
                       VerticalAlignment="Center" Margin="2"/>
           
            <TextBlock x:Name="Step2Text" Text="2" Background="LightGray" Width="25" 
                       Height="25" TextAlignment="Center" 
                       VerticalAlignment="Center" Margin="2"/>
           
            <TextBlock x:Name="Step3Text" Text="3" Background="LightGray" Width="25" 
                       Height="25" TextAlignment="Center" 
                       VerticalAlignment="Center" Margin="2"/>
           
            <TextBlock x:Name="Step4Text" Text="4" Background="LightGray" Width="25" 
                       Height="25" TextAlignment="Center" 
                       VerticalAlignment="Center" Margin="2"/>
           
            <TextBlock x:Name="Step5Text" Text="5" Background="LightGray" Width="25" 
                       Height="25" TextAlignment="Center" 
                       VerticalAlignment="Center" Margin="2"/>
        </StackPanel>

        <!-- Область для страниц -->
        <Frame x:Name="MainFrame" Grid.Row="2" 
               NavigationUIVisibility="Hidden"
               Margin="10" />

        <!-- Кнопки -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" 
                    HorizontalAlignment="Center" Margin="10">
            <Button x:Name="BackButton" Content="Назад" 
                    Width="80" Margin="5" Click="BackButton_Click"
                    IsEnabled="False"/>
            <Button x:Name="NextButton" Content="Далее" 
                    Width="80" Margin="5" Click="NextButton_Click"/>
        </StackPanel>
    </Grid>
</Window>